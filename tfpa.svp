// A simple test bench for the fp adder
`timescale 1ns/10ps

module top();
    typedef struct packed {
        reg Sign;
        reg [4:0] Exp;
        reg [5:0] Fract;
    } FP;
    typedef struct packed {
        FP A,B,C,D;
        FP Z;
        int cntr;
    } FPS;
    reg clk,reset;
    reg pushin,pushout;
    FP A,B,C,D;
    FP Z;
    FPS eres[$];

